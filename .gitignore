.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# local database
*.db
*.sqlite
*.sqlite3

# secrets -- never commit
.env
.env.*
!.env.example

# The client's own master data is mounted, not committed.
# Clone it into place:
#   git clone --depth 1 https://github.com/Ai-Whisperers/wiseq-ai-onboarding.git data/wiseq-repo
data/wiseq-repo/

# Generated audit output (regenerate with scripts/audit_public_site.py).
# These are derived from the PUBLIC website, so they are safe to commit,
# and the bol.com snapshot is the offline fallback the audit needs.
# The trimmed snapshot IS committed -- the audit tests need it offline.
# Only the dated/rollover copies of the UNTRIMMED run are ignored.
data/public/public-site-audit-2026-*.json
data/public/public-site-audit-latest.json.orig
data/public/public-site-audit-*.md
data/public/public-page-audit-*.json
!data/public/public-page-audit-snapshot.json
data/public/public-page-audit-*.md
data/public/mcp-review-*.json
data/public/mcp-review-*.md
data/*.csv

# Fleet orchestrator artifacts (per-ticket, regenerated each dispatch).
# These appear in EVERY worktree the fleet creates and pollute PR diffs.
.dispatch-body.md
.dispatch-result.json
.dispatch-findings.yaml
.pr-body.md

# Resumable UCP scan progress is a local runtime artefact, not source.
data/wiseq.ucp_scan.json
data/ucp_scan_loop.log
data/public/ucp-discovery-*.json
data/public/ucp-discovery-*.md
