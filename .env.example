# WiseQ Hermes -- environment template.
#
# Copy to `.env` and fill in.  NOTHING in this file is a real credential:
# every secret value is written as [REDACTED] on purpose.  Rob fills in the
# real values himself, in his own environment, never in this repository.

# ---------------------------------------------------------------- storage
# Local dev (default): a file-backed SQLite database in the project root.
WISEQ_DATABASE_URL=sqlite:///./wiseq.db

# Production: Supabase (or any PostgreSQL).  Use the *session* pooler URL
# for the app and the *direct* host for migrations.
#   WISEQ_DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[REDACTED]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Supabase also needs this for migrations; keep it out of logs.
#   SUPABASE_DB_PASSWORD=[REDACTED]

# ------------------------------------------------------------ client data
# Root of the WiseQ client data repository (the folder containing `data/`).
# In Docker this is usually a mounted volume: /data/wiseq-repo
WISEQ_REPO_DIR=./wiseq-repo

# ------------------------------------------------------------------- mail
# EVERY message generated by this system is delivered here.  Dummy sender
# identities are used so no real customer is ever contacted.
WISEQ_TEST_RECIPIENT=weissvanderpol@gmail.com
WISEQ_TEST_SENDER=wiseq-agent@example.invalid

# Local MailHog (Docker Compose ships one on port 1025 / UI on 8025).
SMTP_HOST=mailhog
SMTP_PORT=1025

# ------------------------------------------------------- business constants
# Changing these changes the behaviour of every agent, so they are
# configuration, not code.
#
# WISEQ_SCHOOL_DISCOUNT_PCT -- PLACEHOLDER, NOT A VERIFIED WISEQ RULE.
#
# The live site publishes *staffelprijzen* (volume tiers) whose prices show
# only after business registration. It does not publish a flat school
# discount, and no percentage appears in the client's operating manual or
# in the 2026-10-28 transcript.
#
# Those tier prices live inside WiseQ's own Shopify app ("Sami B2B
# Wholesale Pricing", embedded as {SamitaWSRegistrationForm:...}), so they
# are NOT in the public catalogue, NOT in the repository, and NOT in the
# UCP/MCP feed. They cannot be synced -- Rob has to export them.
#
# LEAVE THIS AT 0 UNTIL THAT EXPORT EXISTS.
# The value below is 0, not 15, on purpose: shipping 15 in this file
# would have silently promoted an invented discount to a confirmed rule
# for anyone who ran the documented `cp .env.example .env` setup.
# With 0 the flag stays on and the demo labels the line as a placeholder.
WISEQ_SCHOOL_DISCOUNT_PCT=0

# WISEQ_SCHOOL_DISCOUNT_CONFIRMED -- set to true ONLY when the value above
# came from Rob's real staffel export. Until then the discount line stays
# labelled a placeholder in the demo and reported as a placeholder by
# /health. Note that 0 and 15 can never be confirmed -- neither is a
# verified WiseQ rule.
WISEQ_SCHOOL_DISCOUNT_CONFIRMED=false
WISEQ_REVIEW_DELAY_DAYS=7
WISEQ_STRIKE_ESCALATION=3

# ------------------------------------------------------------------ server
WISEQ_API_HOST=0.0.0.0
WISEQ_API_PORT=8000

# ------------------------------------------------------------------ auth
# WISEQ_API_TOKEN -- REQUIRED whenever the API is reachable from
# outside the machine it runs on.
#
# The API can raise approvals, draft offers and trigger a live price
# sync.  With WISEQ_API_HOST=0.0.0.0 and no token, that would be open
# to the internet -- so remote access FAILS CLOSED until you set this.
#
# The rules:
#   * /health and /metrics stay open (liveness probes need them);
#   * reads from 127.0.0.1 need no token (local dev, the smoke test);
#   * EVERY write needs the token, from anywhere;
#   * remote reads need the token.
#
# Generate one with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# Clients send it as  X-WiseQ-Token: <token>  or
#                 Authorization: Bearer <token>
# LEAVE IT EMPTY FOR LOCAL USE ONLY -- with no token the container
# refuses remote traffic rather than serving it unprotected.
WISEQ_API_TOKEN=
